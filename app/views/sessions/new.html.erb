<% content_for :title, "Login - OfficeFloorplanAI" %>

<div class="auth-container">
  <h2>Login</h2>

  <%= form_with(url: login_path, method: :post, local: true, class: "auth-form") do |f| %>
    <% if flash[:alert] %>
      <div class="error-messages">
        <p><%= flash[:alert] %></p>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email, class: "form-control", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, class: "form-control", required: true %>
    </div>

    <%= f.submit "Login", class: "btn btn-primary btn-block" %>
  <% end %>

  <div class="auth-links">
    Don't have an account? <%= link_to "Sign Up", signup_path %>
  </div>
</div>
