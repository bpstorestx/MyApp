<% content_for :title, "Account Management - OfficeFloorplanAI" %>

<div class="account-container">
  <h1>Account Management</h1>
  
  <div class="account-info">
    <h2>Account Information</h2>
    <div class="info-section">
      <p><strong>Email:</strong> <%= @user.email %></p>
      <p><strong>Member since:</strong> <%= @user.created_at.strftime('%B %d, %Y') %></p>
    </div>
  </div>

  <div class="usage-info">
    <h2>Usage This Month</h2>
    
    <% if @user.has_unlimited_generations? %>
      <div class="unlimited-usage">
        <div class="status-badge unlimited">∞ Unlimited Generations</div>
        <p>As a premium member, you have unlimited access to all floorplan generation features!</p>
      </div>
    <% else %>
      <div class="usage-tracking">
        <div class="usage-stats">
          <div class="stat-card">
            <div class="stat-number"><%= @user.image_generations_used %></div>
            <div class="stat-label">Used</div>
          </div>
          <div class="stat-divider">/</div>
          <div class="stat-card">
            <div class="stat-number"><%= User::FREE_TIER_MONTHLY_LIMIT %></div>
            <div class="stat-label">Total</div>
          </div>
          <div class="stat-card remaining">
            <div class="stat-number"><%= @user.image_generations_remaining %></div>
            <div class="stat-label">Remaining</div>
          </div>
        </div>
        
        <div class="progress-section">
          <div class="progress">
            <div class="progress-bar" style="width: <%= @user.usage_percentage %>%"></div>
          </div>
          <div class="progress-text">
            <%= @user.usage_percentage %>% used this month
          </div>
        </div>
        
        <% if @user.image_generations_remaining > 0 %>
          <div class="usage-info-text">
            <p>You have <strong><%= @user.image_generations_remaining %> generations remaining</strong> this month.</p>
            <% if @user.next_reset_date %>
              <p class="reset-text">Your usage will reset on <%= @user.next_reset_date.strftime('%B 1, %Y') %>.</p>
            <% end %>
          </div>
        <% else %>
          <div class="usage-limit-reached">
            <p><strong>You've reached your monthly limit!</strong></p>
            <p>Upgrade to premium for unlimited floorplan generations.</p>
          </div>
        <% end %>
        
        <div class="upgrade-prompt">
          <h3>Want Unlimited Generations?</h3>
          <p>Upgrade to premium and never worry about limits again!</p>
          <%= button_to "Upgrade to Premium ($9/month)", subscribe_path, 
              method: :post,
              class: "btn btn-primary btn-lg",
              data: { 
                confirm: "Ready to upgrade to premium for $9/month?",
                disable_with: "Processing..." 
              } %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="subscription-info">
    <h2>Subscription Status</h2>
    
    <% if @user.subscribed? %>
      <div class="subscription-active">
        <div class="status-badge active">✓ Active Subscription</div>
        
        <% if @subscription_details %>
          <div class="subscription-details">
            <p><strong>Plan:</strong> AI Floorplan Design Premium ($9/month)</p>
            <p><strong>Status:</strong> 
              <span class="status-<%= @subscription_details[:status] %>">
                <%= @subscription_details[:status].titleize %>
              </span>
            </p>
            
            <% if @subscription_details[:current_period_start] && @subscription_details[:current_period_end] %>
              <p><strong>Current billing period:</strong> 
                <%= @subscription_details[:current_period_start].strftime('%B %d, %Y') %> - 
                <%= @subscription_details[:current_period_end].strftime('%B %d, %Y') %>
              </p>
              <p><strong>Next billing date:</strong> 
                <%= @subscription_details[:current_period_end].strftime('%B %d, %Y') %>
              </p>
              
              <% if @subscription_details[:cancel_at_period_end] %>
                <div class="cancellation-notice">
                  <p><strong>⚠️ Subscription set to cancel:</strong> Your subscription will end on <%= @subscription_details[:current_period_end].strftime('%B %d, %Y') %></p>
                  <p>You'll continue to have access until then.</p>
                  
                  <%= button_to "Reactivate Subscription", reactivate_subscription_path, 
                      method: :patch,
                      class: "btn btn-success",
                      data: { 
                        confirm: "Are you sure you want to reactivate your subscription? You'll be charged $9/month starting from the next billing cycle." 
                      } %>
                </div>
              <% else %>
                <div class="cancel-section">
                  <%= button_to "Cancel Subscription", cancel_subscription_path, 
                      method: :patch,
                      class: "btn btn-danger",
                      data: { 
                        confirm: "Are you sure you want to cancel your subscription? You'll lose access to premium features at the end of your current billing period." 
                      } %>
                  <p class="cancel-note">You'll continue to have access until <%= @subscription_details[:current_period_end].strftime('%B %d, %Y') %></p>
                </div>
              <% end %>
            <% else %>
              <div class="subscription-warning">
                <p><strong>⚠️ Billing information unavailable</strong></p>
                <p>Your subscription is active, but we're having trouble loading billing details from Stripe.</p>
                
                <div class="cancel-section">
                  <%= button_to "Cancel Subscription", cancel_subscription_path, 
                      method: :patch,
                      class: "btn btn-danger",
                      data: { 
                        confirm: "Are you sure you want to cancel your subscription? You'll lose access to premium features." 
                      } %>
                  <p class="cancel-note">This will cancel your subscription at the end of the current billing period.</p>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p>Unable to load subscription details. Please refresh the page or contact support.</p>
        <% end %>
      </div>
      
    <% else %>
      <div class="subscription-inactive">
        <div class="status-badge inactive">No Active Subscription</div>
        <p>You don't currently have an active subscription.</p>
        
        <div class="upgrade-section">
          <%= button_to "Upgrade to Premium ($9/month)", subscribe_path, 
              method: :post,
              class: "btn btn-primary btn-lg",
              data: { 
                confirm: "Ready to upgrade to premium for $9/month?",
                disable_with: "Processing..." 
              } %>
        </div>
        
        <div class="features-list">
          <h3>Premium Features Include:</h3>
          <ul>
            <li>✓ Unlimited floorplan uploads</li>
            <li>✓ Advanced AI layout generation</li>
            <li>✓ Custom design prompts</li>
            <li>✓ High-resolution exports</li>
            <li>✓ Priority support</li>
          </ul>
        </div>
      </div>
    <% end %>
  </div>

  <div class="account-actions">
    <h2>Account Actions</h2>
    <div class="action-links">
      <%= link_to "View My Floorplans", floorplans_path, class: "btn btn-outline" %>
      <%= link_to "Create New Floorplan", new_floorplan_path, class: "btn btn-outline" %>
    </div>
  </div>
</div> 