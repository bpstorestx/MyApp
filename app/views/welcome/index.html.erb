<% content_for :title, "Welcome to FloorPlan Pro" %>
<% content_for :description, "Upload your commercial office floorplan and receive an AI-redesigned layout. Visualize new possibilities for your workspace." %>

<section class="welcome-section">
  <div class="container">
    <h1>Welcome to FloorPlan Pro</h1>
    
    <p>
      Upload your commercial office floorplan and receive an AI-redesigned layout.
      Our tool helps you visualize new possibilities for your workspace.
    </p>

    <div class="cta-section">
      <%= link_to "Upload Floorplan", new_floorplan_path, class: "btn btn-primary btn-lg" %>
    </div>

    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">📐</div>
        <h3>Simple Upload Process</h3>
        <p>Just drag and drop your floorplan image, and we'll handle the rest with our advanced AI processing.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">🤖</div>
        <h3>Advanced AI Layout Generation</h3>
        <p>Our machine learning algorithms analyze your space and generate optimized layouts based on modern design principles.</p>
      </div>
      
      <div class="feature-card">
        <div class="feature-icon">📊</div>
        <h3>Compare Designs</h3>
        <p>View your original floorplan side-by-side with our AI-generated alternatives to make informed decisions.</p>
      </div>
    </div>
  </div>
</section>

<section class="container">
  <div class="card">
    <div class="card-body text-center">
      <h3>About BPStoresTX</h3>
      <p>My name is <%= logged_in? ? current_user.email : "Guest" %> and I like football.</p>
      <p>I live in Texas and I run the LLC BPStoresTX, dedicated to bringing innovative design solutions to businesses across the state.</p>
    </div>
  </div>
</section> 