<% content_for :title, "Welcome to OfficeFloorplanAI" %>
<% content_for :description, "Upload your commercial office floorplan and receive an AI-redesigned layout. Visualize new possibilities for your workspace." %>

<!-- Enhanced Hero Section -->
<section class="gradient-bg-hero relative overflow-hidden">
  <!-- Animated Background Elements -->
  <div class="absolute inset-0 opacity-20">
    <div class="absolute top-20 left-10 w-32 h-32 bg-white rounded-full animate-float"></div>
    <div class="absolute top-40 right-20 w-20 h-20 bg-white rounded-full animate-float" style="animation-delay: 2s;"></div>
    <div class="absolute bottom-20 left-1/4 w-16 h-16 bg-white rounded-full animate-float" style="animation-delay: 4s;"></div>
  </div>
  
  <div class="container-custom py-24 lg:py-32 relative z-10">
    <div class="text-center">
      <div class="mb-8">
        <span class="inline-block px-6 py-2 bg-white/20 backdrop-blur-sm rounded-full text-white text-sm font-semibold border border-white/30 animate-pulse-slow">
          🚀 AI-Powered Design Revolution
        </span>
      </div>
      
      <h1 class="text-5xl lg:text-7xl font-black text-white mb-8 leading-tight">
        Transform Your Office with
        <span class="block text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 to-pink-300 animate-pulse-slow">
          AI-Powered Design
        </span>
      </h1>
      
      <div class="flex justify-center">
        <p class="text-xl lg:text-2xl text-white/90 mb-12 max-w-4xl leading-relaxed font-medium text-center">
          Upload your commercial office floorplan and receive professionally redesigned layouts. 
          Visualize new possibilities for your workspace with cutting-edge AI technology.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
        <%= link_to "Upload Floorplan", new_floorplan_path, 
            class: "btn-primary px-10 py-4 text-lg font-bold shadow-2xl transform hover:scale-110 hover:-rotate-1 transition-all duration-300" %>
        <% unless logged_in? %>
          <%= link_to "Sign Up Free", signup_path, 
              class: "btn border-2 border-white text-white hover:bg-white hover:text-purple-600 px-10 py-4 text-lg font-bold shadow-2xl transform hover:scale-110 hover:rotate-1 transition-all duration-300" %>
        <% end %>
      </div>
      
      <!-- Trust Indicators -->
      <div class="mt-16 grid grid-cols-3 gap-8 max-w-2xl mx-auto">
        <div class="text-center">
          <div class="text-3xl font-black text-white">1000+</div>
          <div class="text-white/80 text-sm">Designs Created</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-black text-white">98%</div>
          <div class="text-white/80 text-sm">Satisfaction Rate</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-black text-white">24/7</div>
          <div class="text-white/80 text-sm">AI Processing</div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Gradient overlay -->
  <div class="absolute bottom-0 inset-x-0 h-32 bg-gradient-to-t from-gray-50 to-transparent"></div>
</section>

<!-- Enhanced Features Section -->
<section class="py-24 lg:py-32 bg-gray-50 relative">
  <div class="container-custom">
    <div class="text-center mb-20">
      <span class="inline-block px-6 py-2 bg-blue-100 text-blue-600 rounded-full text-sm font-bold mb-6">
        ✨ Why Choose OfficeFloorplanAI?
      </span>
      <h2 class="text-4xl lg:text-6xl font-black text-gray-900 mb-6">
        The Future of Office Design
      </h2>
      <div class="flex justify-center">
        <p class="text-xl text-gray-600 max-w-3xl leading-relaxed text-center">
          Our AI-powered platform makes office design simple, fast, and professional. 
          Experience the next generation of workspace planning.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-16">
      <!-- Feature 1 -->
      <div class="text-center group">
        <div class="relative mb-8">
          <div class="w-24 h-24 bg-gradient-to-br from-blue-500 to-purple-600 rounded-3xl flex items-center justify-center mx-auto shadow-2xl group-hover:shadow-3xl group-hover:scale-110 transition-all duration-500 animate-float">
            <div class="text-4xl">📐</div>
          </div>
          <div class="absolute -top-2 -right-2 w-6 h-6 bg-yellow-400 rounded-full animate-ping"></div>
        </div>
        <h3 class="text-2xl font-black text-gray-900 mb-4">Simple Upload Process</h3>
        <p class="text-gray-600 leading-relaxed text-lg">
          Just drag and drop your floorplan image, and we'll handle the rest with our advanced AI processing. 
          No technical expertise required - it's that simple!
        </p>
      </div>
      
      <!-- Feature 2 -->
      <div class="text-center group">
        <div class="relative mb-8">
          <div class="w-24 h-24 bg-gradient-to-br from-green-500 to-emerald-600 rounded-3xl flex items-center justify-center mx-auto shadow-2xl group-hover:shadow-3xl group-hover:scale-110 transition-all duration-500 animate-float" style="animation-delay: 2s;">
            <div class="text-4xl">🤖</div>
          </div>
          <div class="absolute -top-2 -right-2 w-6 h-6 bg-pink-400 rounded-full animate-ping" style="animation-delay: 1s;"></div>
        </div>
        <h3 class="text-2xl font-black text-gray-900 mb-4">Advanced AI Layout Generation</h3>
        <p class="text-gray-600 leading-relaxed text-lg">
          Our machine learning algorithms analyze your space and generate optimized layouts based on modern design principles and workflow efficiency.
        </p>
      </div>
      
      <!-- Feature 3 -->
      <div class="text-center group">
        <div class="relative mb-8">
          <div class="w-24 h-24 bg-gradient-to-br from-orange-500 to-red-600 rounded-3xl flex items-center justify-center mx-auto shadow-2xl group-hover:shadow-3xl group-hover:scale-110 transition-all duration-500 animate-float" style="animation-delay: 4s;">
            <div class="text-4xl">📊</div>
          </div>
          <div class="absolute -top-2 -right-2 w-6 h-6 bg-blue-400 rounded-full animate-ping" style="animation-delay: 2s;"></div>
        </div>
        <h3 class="text-2xl font-black text-gray-900 mb-4">Compare & Analyze Designs</h3>
        <p class="text-gray-600 leading-relaxed text-lg">
          View your original floorplan side-by-side with our AI-generated alternatives. Make informed decisions with detailed analysis and insights.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Enhanced About Section -->
<section class="py-24 lg:py-32 relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-5">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, rgba(0,0,0,0.3) 1px, transparent 0); background-size: 50px 50px;"></div>
  </div>
  
  <div class="container-custom relative z-10">
    <div class="max-w-5xl mx-auto">
      <div class="card shadow-3xl border-2 border-blue-100 hover:border-blue-200 transition-all duration-500">
        <div class="card-body text-center py-16">
          <div class="mb-8">
            <div class="w-20 h-20 bg-gradient-to-br from-blue-500 to-purple-600 rounded-3xl flex items-center justify-center mx-auto shadow-2xl mb-6 animate-float">
              <span class="text-3xl">🏢</span>
            </div>
            <h3 class="text-3xl lg:text-5xl font-black text-gray-900 mb-8">About BPStoresTX</h3>
          </div>
          
          <div class="prose prose-xl mx-auto text-gray-600 leading-relaxed">
            <p class="mb-6 text-xl font-medium">
              Welcome, <span class="text-blue-600 font-bold"><%= logged_in? ? current_user.email : "Guest" %></span>! We're passionate about bringing innovative design solutions to businesses across Texas and beyond.
            </p>
            <p class="mb-8 text-lg">
              Based in the heart of Texas, BPStoresTX LLC is dedicated to transforming commercial spaces through cutting-edge AI technology. 
              Our mission is to make professional office design accessible to everyone, from small startups to large enterprises.
            </p>
            
            <div class="inline-flex items-center space-x-3 px-8 py-4 bg-gradient-to-r from-blue-500 to-purple-600 text-white rounded-2xl shadow-xl">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
              </svg>
              <span class="font-bold text-lg">Proudly serving from Texas, United States</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Enhanced CTA Section -->
<section class="py-24 lg:py-32 gradient-bg-primary relative overflow-hidden">
  <!-- Animated background elements -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-0 w-96 h-96 bg-white rounded-full -translate-x-1/2 -translate-y-1/2 animate-pulse"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-white rounded-full translate-x-1/2 translate-y-1/2 animate-pulse" style="animation-delay: 3s;"></div>
  </div>
  
  <div class="container-custom text-center relative z-10">
    <div class="mb-8">
      <span class="inline-block px-6 py-2 bg-white/20 backdrop-blur-sm rounded-full text-white text-sm font-semibold border border-white/30">
        🎯 Ready to Get Started?
      </span>
    </div>
    
    <h2 class="text-4xl lg:text-6xl font-black text-white mb-8">
      Ready to Transform Your Office?
    </h2>
    <div class="flex justify-center">
      <p class="text-xl text-white/90 mb-12 max-w-3xl leading-relaxed font-medium text-center">
        Join thousands of businesses who have revolutionized their workspace design with OfficeFloorplanAI. 
        Your perfect office layout is just one click away.
      </p>
    </div>
    
    <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
      <%= link_to "Get Started Now", new_floorplan_path, 
          class: "btn bg-white text-purple-600 hover:bg-gray-100 px-12 py-4 text-xl font-black shadow-2xl transform hover:scale-110 hover:-rotate-1 transition-all duration-300" %>
      <div class="text-white/80 text-sm">
        ✨ No credit card required • Start in 30 seconds
      </div>
    </div>
  </div>
</section> 