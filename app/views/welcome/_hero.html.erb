<section class="bg-gray-50 py-16 px-4">
  <div class="max-w-2xl mx-auto text-center">
    <h1 class="text-xs font-bold text-gray-500 sm:text-sm lg:text-base mb-4">
      The #1 AI Office Design Generator for Commercial Spaces
    </h1>
    
    <h2 class="text-3xl font-bold text-slate-800 sm:text-4xl lg:text-5xl xl:text-6xl mb-6 leading-tight">
      Professional office layouts, without hiring a designer
    </h2>
    
    <p class="text-base font-medium text-gray-600 sm:text-lg mb-8">
      Get professional office redesigns in minutes with our AI floorplan generator. Upload your floorplan, pick your style & receive optimized layouts.
    </p>
    
    <div class="flex flex-col md:flex-row gap-4 justify-center items-center">
      <%= link_to new_floorplan_path, 
          class: "font-bold py-3 px-8 rounded-lg transition-colors w-full md:w-auto",
          style: "background-color: #f97316; color: white; text-decoration: none; border: none;" do %>
        Upload your floorplan now
      <% end %>
      
      <span class="text-gray-400 text-sm hidden md:block">OR</span>
      
      <% unless logged_in? %>
        <%= link_to signup_path, 
            class: "bg-white border border-gray-300 text-gray-700 font-medium py-3 px-8 rounded-lg hover:bg-gray-50 transition-colors w-full md:w-auto" do %>
          Sign Up Free
        <% end %>
      <% end %>
    </div>
  </div>
</section> 