<header class="glass sticky top-0 z-50 border-b border-white/20">
  <div class="container-custom">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <%= link_to root_path, class: "flex items-center space-x-3 text-2xl font-bold text-gradient hover:scale-105 transition-all duration-200" do %>
        <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 rounded-2xl flex items-center justify-center shadow-xl animate-float">
          <span class="text-white font-black text-lg">OAI</span>
        </div>
        <span class="hidden sm:block">OfficeFloorplanAI</span>
      <% end %>
      
      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center space-x-2">
        <%= link_to "New Floorplan", new_floorplan_path, 
            class: "px-4 py-2 text-gray-700 hover:text-blue-600 hover:bg-blue-50 rounded-xl font-semibold transition-all duration-200 hover:scale-105" %>
        <% if logged_in? %>
          <%= link_to "My Floorplans", floorplans_path, 
              class: "px-4 py-2 text-gray-700 hover:text-blue-600 hover:bg-blue-50 rounded-xl font-semibold transition-all duration-200 hover:scale-105" %>
          <%= link_to "Account", account_path, 
              class: "px-4 py-2 text-gray-700 hover:text-blue-600 hover:bg-blue-50 rounded-xl font-semibold transition-all duration-200 hover:scale-105" %>
        <% else %>
          <%= link_to "Login", login_path, 
              class: "px-4 py-2 text-gray-700 hover:text-blue-600 hover:bg-blue-50 rounded-xl font-semibold transition-all duration-200 hover:scale-105" %>
        <% end %>
      </nav>
      
      <!-- User Actions -->
      <div class="hidden md:flex items-center space-x-4">
        <% if logged_in? %>
          <% unless current_user.subscribed? %>
            <%= button_to "Upgrade", subscribe_path, method: :post, 
                class: "btn-primary px-6 py-2 text-sm font-bold animate-pulse-slow", 
                data: { 
                  confirm: "Ready to upgrade to premium for $9/month?",
                  disable_with: "Processing..." 
                },
                form: { style: "display: inline;" } %>
          <% else %>
            <span class="status-badge success">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              Premium
            </span>
          <% end %>
          
          <!-- Enhanced User Menu -->
          <div class="relative inline-block text-left" x-data="{ open: false }">
            <button @click="open = !open" class="flex items-center space-x-2 p-2 hover:bg-blue-50 rounded-xl transition-all duration-200 hover:scale-105">
              <div class="w-10 h-10 bg-gradient-to-br from-blue-400 to-purple-500 rounded-xl flex items-center justify-center shadow-lg">
                <span class="text-white font-bold text-sm">
                  <%= current_user.email.first.upcase %>
                </span>
              </div>
              <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            
            <div x-show="open" @click.away="open = false" 
                 x-transition:enter="transition ease-out duration-200" 
                 x-transition:enter-start="transform opacity-0 scale-95" 
                 x-transition:enter-end="transform opacity-100 scale-100" 
                 x-transition:leave="transition ease-in duration-75" 
                 x-transition:leave-start="transform opacity-100 scale-100" 
                 x-transition:leave-end="transform opacity-0 scale-95" 
                 class="absolute right-0 mt-2 w-56 glass rounded-2xl shadow-2xl ring-1 ring-black/5">
              <div class="p-2">
                <div class="px-4 py-3 text-sm text-gray-600 border-b border-gray-100/50 mb-2">
                  <div class="font-semibold text-gray-900"><%= current_user.email %></div>
                  <div class="text-xs text-gray-500">Premium Member</div>
                </div>
                <%= button_to "Logout", logout_path, method: :delete, 
                    class: "w-full text-left px-4 py-3 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 rounded-xl transition-all duration-200 font-medium" %>
              </div>
            </div>
          </div>
        <% else %>
          <%= link_to "Sign Up", signup_path, class: "btn-primary px-6 py-2 text-sm font-bold" %>
        <% end %>
      </div>
      
      <!-- Enhanced Mobile menu button -->
      <button type="button" class="md:hidden p-3 rounded-xl text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-all duration-200 hover:scale-105" id="mobileNavToggle" aria-label="Toggle navigation" aria-expanded="false">
        <svg class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    
    <!-- Enhanced Mobile Navigation Menu -->
    <div class="md:hidden hidden" id="mobileNav">
      <div class="px-4 pt-4 pb-6 space-y-2 border-t border-gray-100/50">
        <%= link_to "New Floorplan", new_floorplan_path, 
            class: "block px-4 py-3 text-gray-700 hover:text-blue-600 hover:bg-blue-50 rounded-xl font-semibold transition-all duration-200" %>
        <% if logged_in? %>
          <%= link_to "My Floorplans", floorplans_path, 
              class: "block px-4 py-3 text-gray-700 hover:text-blue-600 hover:bg-blue-50 rounded-xl font-semibold transition-all duration-200" %>
          <%= link_to "Account", account_path, 
              class: "block px-4 py-3 text-gray-700 hover:text-blue-600 hover:bg-blue-50 rounded-xl font-semibold transition-all duration-200" %>
          
          <div class="px-4 py-4 border-t border-gray-100 mt-4">
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-10 h-10 bg-gradient-to-br from-blue-400 to-purple-500 rounded-xl flex items-center justify-center shadow-lg">
                <span class="text-white font-bold text-sm">
                  <%= current_user.email.first.upcase %>
                </span>
              </div>
              <div>
                <div class="text-sm font-semibold text-gray-900"><%= current_user.email %></div>
                <div class="text-xs text-gray-500">Premium Member</div>
              </div>
            </div>
            
            <% unless current_user.subscribed? %>
              <%= button_to "Upgrade to Premium", subscribe_path, method: :post, 
                  class: "w-full btn-primary mb-3", 
                  data: { 
                    confirm: "Ready to upgrade to premium for $9/month?",
                    disable_with: "Processing..." 
                  } %>
            <% else %>
              <div class="status-badge success mb-3">
                <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                Premium Member
              </div>
            <% end %>
            
            <%= button_to "Logout", logout_path, method: :delete, 
                class: "w-full text-center px-4 py-3 text-sm text-gray-700 hover:bg-red-50 hover:text-red-600 rounded-xl transition-all duration-200 border border-gray-200" %>
          </div>
        <% else %>
          <%= link_to "Login", login_path, 
              class: "block px-4 py-3 text-gray-700 hover:text-blue-600 hover:bg-blue-50 rounded-xl font-semibold transition-all duration-200" %>
          <%= link_to "Sign Up", signup_path, class: "block btn-primary text-center mt-4" %>
        <% end %>
      </div>
    </div>
  </div>
</header>

<!-- Enhanced Flash Messages -->
<% if flash[:notice] || flash[:alert] %>
  <div class="relative z-40">
    <% if flash[:notice] %>
      <div class="glass border-l-4 border-green-400 p-4 m-4 rounded-xl shadow-lg">
        <div class="container-custom">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-gradient-to-br from-green-400 to-emerald-500 rounded-xl flex items-center justify-center shadow-lg">
                <svg class="w-5 h-5 text-white" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
            <div class="ml-4">
              <p class="text-sm font-semibold text-green-800"><%= flash[:notice] %></p>
            </div>
          </div>
        </div>
      </div>
    <% end %>
    
    <% if flash[:alert] %>
      <div class="glass border-l-4 border-red-400 p-4 m-4 rounded-xl shadow-lg">
        <div class="container-custom">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <div class="w-8 h-8 bg-gradient-to-br from-red-400 to-rose-500 rounded-xl flex items-center justify-center shadow-lg">
                <svg class="w-5 h-5 text-white" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </div>
            </div>
            <div class="ml-4">
              <p class="text-sm font-semibold text-red-800"><%= flash[:alert] %></p>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<script>
// Enhanced mobile navigation functionality
document.addEventListener('DOMContentLoaded', function() {
  const mobileNavToggle = document.getElementById('mobileNavToggle');
  const mobileNav = document.getElementById('mobileNav');
  const hamburgerIcon = mobileNavToggle.querySelector('svg:first-child');
  const closeIcon = mobileNavToggle.querySelector('svg:last-child');
  
  if (mobileNavToggle && mobileNav) {
    mobileNavToggle.addEventListener('click', function() {
      const isVisible = !mobileNav.classList.contains('hidden');
      
      if (isVisible) {
        mobileNav.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        mobileNavToggle.setAttribute('aria-expanded', 'false');
      } else {
        mobileNav.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        mobileNavToggle.setAttribute('aria-expanded', 'true');
      }
    });
    
    // Close mobile nav when clicking outside
    document.addEventListener('click', function(event) {
      if (!mobileNav.contains(event.target) && !mobileNavToggle.contains(event.target)) {
        mobileNav.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        mobileNavToggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
});
</script> 