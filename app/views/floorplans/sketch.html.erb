<h1>Sketch on Your Floorplan</h1>

<% image_to_use = @use_generated && @floorplan.generated_image.attached? ? @floorplan.generated_image : @floorplan.original_image %>
<% image_type = @use_generated && @floorplan.generated_image.attached? ? "generated" : "original" %>

<% if image_to_use.attached? %>
  <!-- Image is loaded as the canvas background, but not modified -->
  <div class="sketch-info alert alert-info">
    <p>Use the tools below to sketch the floorplan you would like to generate. Our Architect will understand but feel free to add text instructions to complicated drawings. Use the Hand tool to navigate around, or scroll to zoom in/out for precise work.</p>
  </div>
  
  <!-- Hidden <img> for background loading -->
  <img id="original-img" src="<%= url_for(image_to_use) %>" style="display: none;" />

  <!-- Fabric canvas for drawing -->
  <div class="canvas-container">
    <canvas id="floorplan-canvas" width="800" height="600"></canvas>
    <div id="custom-cursor" class="cursor-circle"></div>
  </div>
  
  <!-- Tool Panel -->
  <div class="tool-panel">
    <div class="color-options">
      <button id="red-color" class="color-btn active" data-color="#FF0000"></button>
    </div>
    
    <button id="pen-tool" class="tool-btn active">Pen</button>
    <button id="eraser-tool" class="tool-btn">Eraser</button>
    <button id="line-tool" class="tool-btn">Line</button>
    <button id="text-tool" class="tool-btn">Text</button>
    <button id="labels-tool" class="tool-btn">Labels</button>
    <button id="select-tool" class="tool-btn">Select</button>
    
    <!-- Brush size control - for pen and eraser -->
    <div id="brush-controls" class="tool-controls">
      <label>Brush Size: <input type="range" id="size-slider" min="1" max="10" value="3"> <span id="size-value">3</span></label>
    </div>
    
    <!-- Text size control - only shown when text tool is active -->
    <div id="text-controls" class="tool-controls" style="display: none;">
      <label>Font Size: 
        <select id="font-size-select">
          <option value="15">Small</option>
          <option value="23" selected>Medium</option>
          <option value="30">Large</option>
          <option value="45">X-Large</option>
        </select>
      </label>
    </div>
    
    <!-- Labels control - only shown when labels tool is active -->
    <div id="labels-controls" class="tool-controls" style="display: none;">
      <label>Room Label: 
        <select id="label-select">
          <option value="Office">Office</option>
          <option value="Conference">Conference</option>
          <option value="Break">Break</option>
          <option value="Bathroom">Bathroom</option>
          <option value="Open Work Space">Open Work Space</option>
        </select>
      </label>
    </div>
    
    <button id="undo-btn" class="action-btn">Undo</button>
    <button id="clear-btn" class="action-btn warning">Clear Canvas</button>
    
    <!-- Zoom controls -->
    <div class="zoom-controls">
      <button id="zoom-in-btn" class="action-btn">Zoom In</button>
      <button id="zoom-out-btn" class="action-btn">Zoom Out</button>
      <button id="zoom-reset-btn" class="action-btn">Reset Zoom</button>
      <span id="zoom-level">100%</span>
    </div>
    
    <button id="hand-tool" class="action-btn">Hand</button>
  </div>
  
  <!-- Generate button - prominently placed below tools -->
  <div class="custom-prompt-section">
    <h3>Custom Instructions (Optional)</h3>
    <p class="prompt-help">Add specific instructions or requirements for your floorplan generation.</p>
    
    <div class="examples-section">
      <h4>💡 Example Instructions:</h4>
      <ul class="examples-list">
        <li>"Focus on tangible layout design. Open vs closed. Specific numbers. Listing Exact Rooms Required."</li>
        <li>"I need 6 private offices along the perimeter, a large conference room, and an open workspace in the center."</li>
        <li>"A mostly open layout with desks in the center, two enclosed offices along the top wall, a single conference room adjacent to the reception area, and a break area at the far end."</li>
        <li>"If sketching in red, explain your custom sketch edits in the prompt for added accuracy."</li>
      </ul>
    </div>
    
    <textarea id="custom-prompt" placeholder="Example: I need 4 private offices, a large conference room, and an open workspace area. The conference room should be located near the entrance..." rows="4"></textarea>
  </div>
  
  <div class="zoom-guidance">
    <div class="guidance-box">
      <h4>📐 For Best Results:</h4>
      <p><strong>Center your floorplan</strong> with white space around it before generating. Use <strong>"Reset Zoom"</strong> if needed!</p>
    </div>
  </div>
  
  <div class="generate-section">
    <button id="save-btn" class="generate-btn">🏗️ Generate My Floorplan!</button>
    <p class="generate-help">Ready to see your floorplan? Click above to send your sketch to our AI Architect!</p>
  </div>
  
  <div id="status-message" style="margin-top: 10px; padding: 8px; background-color: #f8f9fa; border: 1px solid #ddd; display: none;"></div>
  
  <style>
    .sketch-info.alert.alert-info {
      background-color: #d4f5d4 !important;
      border-color: #a8e6a8 !important;
      color: #2d5a2d !important;
    }
    
    .canvas-container {
      margin: 20px 0;
      border: 1px solid #ddd;
      display: inline-block;
      position: relative;
    }
    
    .cursor-circle {
      position: fixed; /* Change to fixed positioning */
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background-color: rgba(255, 255, 255, 0.4);
      border: 1px solid rgba(0, 0, 0, 0.4);
      pointer-events: none; /* Allow clicks to pass through */
      transform: translate(-50%, -50%); /* Center the circle on cursor */
      z-index: 1000;
      display: none; /* Hidden by default */
    }
    
    /* Add cursor styles for the canvas based on active tool */
    #floorplan-canvas {
      cursor: default;
    }
    
    .pen-active #floorplan-canvas {
      cursor: crosshair;
    }
    
    .line-active #floorplan-canvas {
      cursor: crosshair;
    }
    
