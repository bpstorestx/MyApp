<h1>Sketch on Your Floorplan</h1>

<% image_to_use = @use_generated && @floorplan.generated_image.attached? ? @floorplan.generated_image : @floorplan.original_image %>
<% image_type = @use_generated && @floorplan.generated_image.attached? ? "generated" : "original" %>

<% if image_to_use.attached? %>
  <!-- Image is loaded as the canvas background, but not modified -->
  <div class="sketch-info alert alert-info">
    <p>You are sketching on a copy of your <%= image_type %> floorplan. The <%= image_type %> will remain unchanged.</p>
  </div>
  
  <!-- Hidden <img> for background loading -->
  <img id="original-img" src="<%= url_for(image_to_use) %>" style="display: none;" />

  <!-- Fabric canvas for drawing -->
  <div class="canvas-container">
    <canvas id="floorplan-canvas" width="800" height="600"></canvas>
    <div id="custom-cursor" class="cursor-circle"></div>
  </div>
  
  <!-- Tool Panel -->
  <div class="tool-panel">
    <button id="pen-tool" class="tool-btn active">Pen</button>
    <button id="eraser-tool" class="tool-btn">Eraser</button>
    <button id="line-tool" class="tool-btn">Line</button>
    <button id="text-tool" class="tool-btn">Text</button>
    <button id="select-tool" class="tool-btn">Select</button>
    
    <div class="color-options">
      <button id="red-color" class="color-btn active" data-color="#FF0000"></button>
      <button id="green-color" class="color-btn" data-color="#00FF00"></button>
      <button id="blue-color" class="color-btn" data-color="#0000FF"></button>
      <label>Custom: <input type="color" id="color-picker" value="#FF0000"></label>
    </div>
    
    <!-- Brush size control - for pen and eraser -->
    <div id="brush-controls" class="tool-controls">
      <label>Brush Size: <input type="range" id="size-slider" min="1" max="10" value="3"> <span id="size-value">3</span></label>
    </div>
    
    <!-- Text size control - only shown when text tool is active -->
    <div id="text-controls" class="tool-controls" style="display: none;">
      <label>Font Size: 
        <select id="font-size-select">
          <option value="15">Small</option>
          <option value="23" selected>Medium</option>
          <option value="30">Large</option>
          <option value="45">X-Large</option>
        </select>
      </label>
    </div>
    
    <button id="undo-btn" class="action-btn">Undo</button>
    <button id="clear-btn" class="action-btn warning">Clear Canvas</button>
    <button id="save-btn" class="action-btn primary">Save Sketch</button>
    <a href="<%= floorplan_path(@floorplan) %>" class="action-btn">Cancel</a>
  </div>
  
  <div id="status-message" style="margin-top: 10px; padding: 8px; background-color: #f8f9fa; border: 1px solid #ddd; display: none;"></div>
  
  <style>
    .canvas-container {
      margin: 20px 0;
      border: 1px solid #ddd;
      display: inline-block;
      position: relative;
    }
    
    .cursor-circle {
      position: fixed; /* Change to fixed positioning */
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background-color: rgba(255, 255, 255, 0.4);
      border: 1px solid rgba(0, 0, 0, 0.4);
      pointer-events: none; /* Allow clicks to pass through */
      transform: translate(-50%, -50%); /* Center the circle on cursor */
      z-index: 1000;
      display: none; /* Hidden by default */
    }
    
    /* Add cursor styles for the canvas based on active tool */
    #floorplan-canvas {
      cursor: default;
    }
    
    .pen-active #floorplan-canvas {
      cursor: crosshair;
    }
    
    .line-active #floorplan-canvas {
      cursor: crosshair;
    }
    
    .eraser-active #floorplan-canvas {
      cursor: default; /* We use custom cursor for eraser */
    }
    
    .text-active #floorplan-canvas {
      cursor: text;
    }
    
    .select-active #floorplan-canvas {
      cursor: default;
    }
    
    .tool-panel {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      margin: 15px 0;
      padding: 10px;
      background-color: #f8f9fa;
      border: 1px solid #dee2e6;
      border-radius: 4px;
    }
    
    .tool-btn {
      padding: 6px 12px;
      background-color: #f8f9fa;
      border: 1px solid #ced4da;
      border-radius: 4px;
      cursor: pointer;
    }
    
    .tool-btn.active {
      background-color: #0d6efd;
      color: white;
      border-color: #0a58ca;
    }
    
    .action-btn {
      padding: 6px 12px;
      background-color: #6c757d;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
    }
    
    .action-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    
    .action-btn.primary {
      background-color: #0d6efd;
    }
    
    .action-btn.warning {
      background-color: #dc3545;
    }
    
    .color-options {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-right: 10px;
    }
    
    .color-btn {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      border: 2px solid #ced4da;
      cursor: pointer;
      padding: 0;
    }
    
    .color-btn.active {
      border: 2px solid #000000;
      transform: scale(1.2);
    }
    
    #red-color {
      background-color: #FF0000;
    }
    
    #green-color {
      background-color: #00FF00;
    }
    
    #blue-color {
      background-color: #0000FF;
    }
  </style>

  <!-- Inline script for canvas initialization -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      console.log('DOM loaded, initializing canvas...');
      
      // Find the canvas element for sketching
      const canvasEl = document.getElementById('floorplan-canvas');
      
      if (!canvasEl) {
        console.log('No canvas element found on this page');
        return;
      }
      
      console.log('Canvas element found, initializing Fabric.js...');
      
      // Make sure Fabric.js is loaded
      if (typeof fabric === 'undefined') {
        console.error('Fabric.js is not loaded. Please check the script inclusion.');
        return;
      }
      
      // Create Fabric canvas and enable freehand drawing
      const canvas = new fabric.Canvas('floorplan-canvas', {
        isDrawingMode: true
      });
      
      // Set brush defaults
      canvas.freeDrawingBrush.width = 3;
      canvas.freeDrawingBrush.color = '#FF0000'; // Changed to red default
      
      console.log('Fabric.js canvas initialized successfully');
      
      // Check if we should load a background image
      const originalImg = document.getElementById('original-img');
      if (originalImg && originalImg.complete) {
        loadBackgroundImage(canvas, originalImg);
      } else if (originalImg) {
        originalImg.onload = function() {
          loadBackgroundImage(canvas, originalImg);
        };
      }
      
      // Setup tool buttons
      setupTools(canvas);
    });
    
    // Load the original image as the canvas background
    function loadBackgroundImage(canvas, imgElement) {
      console.log('Loading background image...');
      
      fabric.Image.fromURL(imgElement.src, img => {
        // Scale the image to fit the canvas
        const canvasWidth = canvas.getWidth();
        const canvasHeight = canvas.getHeight();
        
        const scaleX = canvasWidth / img.width;
        const scaleY = canvasHeight / img.height;
        const scale = Math.min(scaleX, scaleY);
        
        img.scale(scale);
        
        // Set as background and render
        canvas.setBackgroundImage(img, canvas.renderAll.bind(canvas));
        console.log('Background image loaded successfully');
      }, { crossOrigin: 'anonymous' });
    }
    
    // Setup the drawing tools
    function setupTools(canvas) {
      const penTool = document.getElementById('pen-tool');
      const eraserTool = document.getElementById('eraser-tool');
      const lineTool = document.getElementById('line-tool');
      const textTool = document.getElementById('text-tool');
      const selectTool = document.getElementById('select-tool');
      const undoBtn = document.getElementById('undo-btn');
      const clearBtn = document.getElementById('clear-btn');
      const saveBtn = document.getElementById('save-btn');
      const colorPicker = document.getElementById('color-picker');
      const sizeSlider = document.getElementById('size-slider');
      const sizeValue = document.getElementById('size-value');
      
      // Color buttons
      const redColorBtn = document.getElementById('red-color');
      const greenColorBtn = document.getElementById('green-color');
      const blueColorBtn = document.getElementById('blue-color');
      
      // Track objects for undo functionality
      const objectHistory = [];
      
      // Flags to track mode
      let currentMode = 'pen'; // Default mode: 'pen', 'eraser', 'text', 'select', 'line'
      
      // Variables for text editing
      let isEditing = false;
      let currentTextObject = null;
      let cursorVisible = true;
      let cursorInterval = null;
      
      // Variables for line drawing
      let isDrawingLine = false;
      let startPoint = null;
      let lineObject = null;
      
      // Helper function to set active button
      function setActiveButton(button) {
        const toolButtons = document.querySelectorAll('.tool-btn');
        toolButtons.forEach(btn => {
          btn.classList.remove('active');
        });
        button.classList.add('active');
        
        // Update canvas cursor based on active tool
        const canvasEl = document.getElementById('floorplan-canvas');
        const canvasContainer = canvasEl.parentElement;
        
        // Remove all tool-specific classes
        canvasContainer.classList.remove('pen-active', 'eraser-active', 'line-active', 'text-active', 'select-active');
        
        // Add class based on current tool
        if (button.id === 'pen-tool') {
          canvasContainer.classList.add('pen-active');
        } else if (button.id === 'eraser-tool') {
          canvasContainer.classList.add('eraser-active');
        } else if (button.id === 'line-tool') {
          canvasContainer.classList.add('line-active');
        } else if (button.id === 'text-tool') {
          canvasContainer.classList.add('text-active');
        } else if (button.id === 'select-tool') {
          canvasContainer.classList.add('select-active');
        }
      }
      
      // Helper function to show/hide tool controls
      function showToolControls(toolType) {
        const brushControls = document.getElementById('brush-controls');
        const textControls = document.getElementById('text-controls');
        
        brushControls.style.display = 'none';
        textControls.style.display = 'none';
        
        if (toolType === 'pen' || toolType === 'eraser' || toolType === 'line') {
          brushControls.style.display = 'block';
        } else if (toolType === 'text') {
          textControls.style.display = 'block';
        }
        
        // Show/hide custom cursor for eraser
        const customCursor = document.getElementById('custom-cursor');
        if (customCursor) {
          if (toolType === 'eraser') {
            customCursor.style.display = 'block';
            updateCursorSize();
          } else {
            customCursor.style.display = 'none';
          }
        }
      }
      
      // Function to update cursor size based on brush size
      function updateCursorSize() {
        const customCursor = document.getElementById('custom-cursor');
        if (!customCursor) return;
        
        const size = sizeSlider ? parseInt(sizeSlider.value) : 3;
        let adjustedSize = size;
        
        // Apply eraser-specific size adjustments
        if (size >= 2 && size <= 6) {
          adjustedSize = size * 1.3; // 30% larger for sizes 2-6
        } else if (size >= 7 && size <= 9) {
          adjustedSize = size * 1.4; // 40% larger for sizes 7-9
        } else if (size === 10) {
          adjustedSize = size * 3.0; // 200% larger for size 10
        }
        
        // Match cursor size to the actual eraser size without padding
        customCursor.style.width = adjustedSize + 'px';
        customCursor.style.height = adjustedSize + 'px';
      }
      
      // Remove existing mouse:down handlers
      canvas.off('mouse:down');
      
      // Add canvas click handler
      canvas.on('mouse:down', function(options) {
        if (currentMode === 'text' && !options.target) {
          // Start text editing at click position
          startTextEditing(options.pointer);
        } else if (currentMode === 'line') {
          if (!isDrawingLine) {
            // Start drawing line
            isDrawingLine = true;
            startPoint = options.pointer;
            
            // Get current color
            let currentColor = colorPicker ? colorPicker.value : '#FF0000';
            
            // Create a temporary line to show as preview
            lineObject = new fabric.Line(
              [startPoint.x, startPoint.y, startPoint.x, startPoint.y], 
              {
                stroke: currentColor,
                strokeWidth: sizeSlider ? parseInt(sizeSlider.value) : 3,
                selectable: false
              }
            );
            canvas.add(lineObject);
            
            console.log('Started line at', startPoint, 'with color', currentColor);
          } else {
            // Finish drawing line
            isDrawingLine = false;
            startPoint = null;
            
            // Add the final line to history for undo
            if (lineObject) {
              objectHistory.push(lineObject);
              
              // Enable the undo button
              if (undoBtn) {
                undoBtn.disabled = false;
              }
              
              console.log('Completed line');
            }
          }
        }
      });
      
      // Mouse move event for cursor positioning and line preview
      canvas.on('mouse:move', function(options) {
        const customCursor = document.getElementById('custom-cursor');
        if (!customCursor) return;
        
        const pointer = options.pointer;
        
        // Only update cursor if it's visible (eraser mode)
        if (customCursor.style.display === 'block') {
          // Get actual mouse coordinates from the event
          const mouseEvent = options.e;
          
          // Position the cursor at the actual mouse position
          customCursor.style.left = mouseEvent.clientX + 'px';
          customCursor.style.top = mouseEvent.clientY + 'px';
        }
        
        // Update line preview if we're drawing a line
        if (currentMode === 'line' && isDrawingLine && lineObject && startPoint) {
          // Update the end point of the line as the mouse moves
          lineObject.set({
            x2: pointer.x,
            y2: pointer.y
          });
          canvas.renderAll();
        }
      });
      
      // Allow double-click to edit text
      canvas.on('mouse:dblclick', function(options) {
        if (options.target && options.target.type === 'text') {
          // Double-clicking on text in select mode enables editing again
          if (currentMode === 'select') {
            currentMode = 'text';
            setActiveButton(textTool);
            showToolControls('text');
            
            // Start editing the existing text
            isEditing = true;
            currentTextObject = options.target;
            
            // Update font size selector to match the text object's font size
            const fontSizeSelect = document.getElementById('font-size-select');
            if (fontSizeSelect) {
              // Find the closest matching option value
              const fontSize = currentTextObject.fontSize;
              const fontSizes = [15, 23, 30, 45]; // The available font sizes
              
              // Find the closest matching size
              let closestSize = fontSizes.reduce((prev, curr) => 
                Math.abs(curr - fontSize) < Math.abs(prev - fontSize) ? curr : prev
              );
              
              fontSizeSelect.value = closestSize;
            }
            
            // Add cursor at the end
            const textWithoutCursor = currentTextObject.text.replace('|', '');
            currentTextObject.set('text', textWithoutCursor + '|');
            
            // Start cursor blinking
            if (cursorInterval) clearInterval(cursorInterval);
            cursorInterval = setInterval(function() {
              if (!isEditing) {
                clearInterval(cursorInterval);
                return;
              }
              
              cursorVisible = !cursorVisible;
              updateTextWithCursor();
            }, 500);
            
            canvas.renderAll();
            
            // Focus for keyboard input
            canvas.wrapperEl.tabIndex = 1000;
            canvas.wrapperEl.focus();
          }
        }
      });
      
      // Helper function to set active color button
      function setActiveColorButton(button) {
        const colorButtons = document.querySelectorAll('.color-btn');
        colorButtons.forEach(btn => {
          btn.classList.remove('active');
        });
        button.classList.add('active');
        
        // Also update the color picker to match
        if (colorPicker) {
          colorPicker.value = button.dataset.color;
        }
      }
      
      // Color buttons click handlers
      if (redColorBtn) {
        redColorBtn.addEventListener('click', () => {
          const color = '#FF0000';
          setActiveColorButton(redColorBtn);
          applySelectedColor(color);
        });
      }
      
      if (greenColorBtn) {
        greenColorBtn.addEventListener('click', () => {
          const color = '#00FF00';
          setActiveColorButton(greenColorBtn);
          applySelectedColor(color);
        });
      }
      
      if (blueColorBtn) {
        blueColorBtn.addEventListener('click', () => {
          const color = '#0000FF';
          setActiveColorButton(blueColorBtn);
          applySelectedColor(color);
        });
      }
      
      // Color picker
      if (colorPicker) {
        colorPicker.addEventListener('input', () => {
          applySelectedColor(colorPicker.value);
          
          // Remove active class from all color buttons when custom color is selected
          const colorButtons = document.querySelectorAll('.color-btn');
          colorButtons.forEach(btn => {
            btn.classList.remove('active');
          });
        });
      }
      
      // Function to apply selected color
      function applySelectedColor(color) {
        if (currentMode === 'eraser') {
          // Don't change eraser color
          return;
        }
        
        // Apply color to selected object if in select mode with an active object
        const activeObject = canvas.getActiveObject();
        if (currentMode === 'select' && activeObject) {
          if (activeObject.type === 'text') {
            activeObject.set('fill', color);
          } else {
            activeObject.set('stroke', color);
          }
          canvas.renderAll();
        } else if (isEditing && currentTextObject) {
          // Apply to current editing text
          currentTextObject.set('fill', color);
          canvas.renderAll();
        } else {
          canvas.freeDrawingBrush.color = color;
        }
        
        console.log('Color changed to: ' + color);
      }
      
      // Size slider - only affects pen and eraser
      if (sizeSlider && sizeValue) {
        sizeSlider.addEventListener('input', () => {
          const size = parseInt(sizeSlider.value);
          
          // Calculate adjusted size based on the tool and size
          let adjustedSize = size;
          
          if (currentMode === 'eraser') {
            // Apply eraser-specific size adjustments
            if (size >= 2 && size <= 6) {
              adjustedSize = size * 1.3; // 30% larger for sizes 2-6
            } else if (size >= 7 && size <= 9) {
              adjustedSize = size * 1.4; // 40% larger for sizes 7-9
            } else if (size === 10) {
              adjustedSize = size * 3.0; // 200% larger for size 10
            }
          } else if (size >= 8) {
            // For pen tool, keep the original 50% increase for 8-10
            adjustedSize = size * 1.5;
          }
          
          // Apply to drawing brush
          canvas.freeDrawingBrush.width = adjustedSize;
          
          // Update cursor size if in eraser mode
          if (currentMode === 'eraser') {
            updateCursorSize();
          }
          
          sizeValue.textContent = size;
          console.log('Brush size changed to: ' + size + ' (adjusted: ' + adjustedSize + ')');
        });
      }
      
      // Font size selector - only affects text
      const fontSizeSelect = document.getElementById('font-size-select');
      if (fontSizeSelect) {
        fontSizeSelect.addEventListener('change', () => {
          const fontSize = parseInt(fontSizeSelect.value);
          
          // Apply to currently editing text
          if (isEditing && currentTextObject) {
            currentTextObject.set('fontSize', fontSize);
            canvas.renderAll();
            console.log('Font size changed to: ' + fontSize);
          }
          
          // Apply to selected text object if in select mode
          const activeObject = canvas.getActiveObject();
          if (currentMode === 'select' && activeObject && activeObject.type === 'text') {
            activeObject.set('fontSize', fontSize);
            canvas.renderAll();
            console.log('Font size changed to: ' + fontSize);
          }
        });
      }
      
      // Track added objects for undo
      canvas.on('object:added', function(e) {
        // Skip adding the cursor/editing text to undo history
        // We'll add the final text when committed
        if (isEditing && e.target === currentTextObject) {
          console.log('Skipping text being edited for undo history');
          return;
        }
        
        // Skip tracking text with cursor
        if (e.target && e.target.type === 'text' && e.target.text && e.target.text.includes('|')) {
          console.log('Skipping text with cursor for undo history');
          return;
        }
        
        // Add object to history
        console.log('Adding to undo history:', e.target.type);
        objectHistory.push(e.target);
        
        // Enable the undo button
        if (undoBtn) {
          undoBtn.disabled = false;
        }
      });
      
      // Function to start text editing at a specific position
      function startTextEditing(pointer) {
        // If already editing, commit the current text
        if (isEditing) {
          commitTextEditing();
        }
        
        // Create a new text object with cursor
        const textObj = new fabric.Text('|', {
          left: pointer.x,
          top: pointer.y,
          fill: colorPicker ? colorPicker.value : '#000000',
          fontSize: document.getElementById('font-size-select') ? 
            parseInt(document.getElementById('font-size-select').value) : 23,
          selectable: true,
          editable: true
        });
        
        // Add to canvas but don't track in history yet until committed
        canvas.add(textObj);
        canvas.renderAll();
        
        // Set up variables for editing
        isEditing = true;
        currentTextObject = textObj;
        
        // Start the cursor blinking
        if (cursorInterval) clearInterval(cursorInterval);
        cursorInterval = setInterval(function() {
          if (!isEditing) {
            clearInterval(cursorInterval);
            return;
          }
          
          cursorVisible = !cursorVisible;
          updateTextWithCursor();
        }, 500);
        
        // Focus the canvas for keyboard input
        canvas.wrapperEl.tabIndex = 1000;
        canvas.wrapperEl.focus();
        
        console.log('Text editing started');
      }
      
      // Function to update text with or without cursor
      function updateTextWithCursor() {
        if (!currentTextObject) return;
        
        const currentText = currentTextObject.text;
        const textWithoutCursor = currentText.replace('|', '');
        
        if (cursorVisible) {
          currentTextObject.set('text', textWithoutCursor + '|');
        } else {
          currentTextObject.set('text', textWithoutCursor);
        }
        
        canvas.renderAll();
      }
      
      // Function to commit text editing
      function commitTextEditing() {
        if (!isEditing || !currentTextObject) return;
        
        // Remove the cursor from the text
        const finalText = currentTextObject.text.replace('|', '');
        
        // If the text is empty, remove the object
        if (finalText === '') {
          // Remove from undo history if present
          const index = objectHistory.indexOf(currentTextObject);
          if (index !== -1) {
            objectHistory.splice(index, 1);
          }
          canvas.remove(currentTextObject);
        } else {
          // Update the text without cursor
          currentTextObject.set('text', finalText);
          
          // Ensure this final text object is in the object history
          // First check if it's already there
          if (!objectHistory.includes(currentTextObject)) {
            objectHistory.push(currentTextObject);
          }
        }
        
        canvas.renderAll();
        
        // Reset variables
        isEditing = false;
        currentTextObject = null;
        if (cursorInterval) {
          clearInterval(cursorInterval);
          cursorInterval = null;
        }
        
        // Switch to select mode after adding text
        if (selectTool) {
          selectTool.click();
        }
        
        console.log('Text editing committed');
      }
      
      // Add keyboard event handlers for text input
      document.addEventListener('keydown', function(e) {
        if (!isEditing) return;
        
        // Prevent default behavior for most keys while editing
        if (e.key !== 'F5' && e.key !== 'F12' && !e.ctrlKey && !e.altKey) {
          e.preventDefault();
        }
        
        if (e.key === 'Escape') {
          // Cancel editing on Escape
          isEditing = false;
          canvas.remove(currentTextObject);
          currentTextObject = null;
          clearInterval(cursorInterval);
          cursorInterval = null;
          
          // Switch back to select mode
          if (selectTool) {
            selectTool.click();
          }
        } else if (e.key === 'Enter') {
          // Commit text on Enter
          commitTextEditing();
        } else if (e.key === 'Backspace') {
          // Handle backspace
          if (isEditing && currentTextObject) {
            const currentText = currentTextObject.text.replace('|', '');
            if (currentText.length > 0) {
              const newText = currentText.substring(0, currentText.length - 1);
              currentTextObject.set('text', newText + (cursorVisible ? '|' : ''));
              canvas.renderAll();
            }
          }
        } else if (e.key.length === 1) {
          // Regular character input
          if (isEditing && currentTextObject) {
            const currentText = currentTextObject.text.replace('|', '');
            currentTextObject.set('text', currentText + e.key + (cursorVisible ? '|' : ''));
            canvas.renderAll();
          }
        }
      });
      
      // Undo button - simple implementation that just removes the last added object
      if (undoBtn) {
        // Disable undo button initially
        undoBtn.disabled = true;
        
        undoBtn.addEventListener('click', function() {
          // Commit any ongoing text editing
          if (isEditing) {
            commitTextEditing();
          }
          
          // Get the last object from history
          if (objectHistory.length > 0) {
            const lastObject = objectHistory.pop();
            
            // Remove the object from canvas
            if (lastObject) {
              console.log('Undoing: removing object type:', lastObject.type);
              canvas.remove(lastObject);
              canvas.renderAll();
              
              console.log('Undo: removed last object');
            }
            
            // Disable undo button if no more objects in history
            if (objectHistory.length === 0) {
              undoBtn.disabled = true;
            }
          }
        });
        
        // Add keyboard shortcut for undo (Ctrl+Z)
        document.addEventListener('keydown', function(e) {
          if ((e.ctrlKey || e.metaKey) && e.key === 'z' && !isEditing) {
            e.preventDefault();
            undoBtn.click();
          }
        });
      }
      
      // Setup tools
      
      // Pen tool
      if (penTool) {
        penTool.addEventListener('click', () => {
          // Commit any ongoing text editing
          if (isEditing) {
            commitTextEditing();
          }
          
          currentMode = 'pen';
          canvas.isDrawingMode = true;
          canvas.selection = false;  // Disable selection in drawing mode
          
          // Make all objects non-selectable in drawing mode
          canvas.forEachObject(function(obj) {
            obj.selectable = false;
          });
          
          canvas.freeDrawingBrush.color = colorPicker ? colorPicker.value : '#000000';
          setActiveButton(penTool);
          showToolControls('pen');
          console.log('Pen tool selected');
        });
      }
      
      // Eraser tool
      if (eraserTool) {
        eraserTool.addEventListener('click', () => {
          // Commit any ongoing text editing
          if (isEditing) {
            commitTextEditing();
          }
          
          currentMode = 'eraser';
          canvas.isDrawingMode = true;
          canvas.selection = false;  // Disable selection in eraser mode
          
          // Make all objects non-selectable in eraser mode
          canvas.forEachObject(function(obj) {
            obj.selectable = false;
          });
          
          // Set eraser color
          canvas.freeDrawingBrush.color = '#ffffff'; // White for eraser
          
          // Apply the size adjustment for current eraser size
          const size = sizeSlider ? parseInt(sizeSlider.value) : 3;
          let adjustedSize = size;
          
          // Apply eraser-specific size adjustments
          if (size >= 2 && size <= 6) {
            adjustedSize = size * 1.3; // 30% larger for sizes 2-6
          } else if (size >= 7 && size <= 9) {
            adjustedSize = size * 1.4; // 40% larger for sizes 7-9
          } else if (size === 10) {
            adjustedSize = size * 3.0; // 200% larger for size 10
          }
          
          canvas.freeDrawingBrush.width = adjustedSize;
          
          setActiveButton(eraserTool);
          showToolControls('eraser');
          console.log('Eraser tool selected');
        });
      }
      
      // Line tool
      if (lineTool) {
        lineTool.addEventListener('click', () => {
          // Commit any ongoing text editing
          if (isEditing) {
            commitTextEditing();
          }
          
          currentMode = 'line';
          canvas.isDrawingMode = false;
          canvas.selection = false;  // Disable selection in line mode
          
          // Make all objects non-selectable in line mode
          canvas.forEachObject(function(obj) {
            obj.selectable = false;
          });
          
          setActiveButton(lineTool);
          showToolControls('line');
          console.log('Line tool selected');
        });
      }
      
      // Text tool
      if (textTool) {
        textTool.addEventListener('click', () => {
          // Commit any ongoing text editing
          if (isEditing) {
            commitTextEditing();
          }
          
          currentMode = 'text';
          canvas.isDrawingMode = false;
          canvas.selection = false;  // Disable selection in text mode to prevent confusion
          
          // Make all objects non-selectable in text mode
          canvas.forEachObject(function(obj) {
            obj.selectable = false;
          });
          
          setActiveButton(textTool);
          showToolControls('text');
          console.log('Text tool selected - Click to add text');
        });
      }
      
      // Select tool
      if (selectTool) {
        selectTool.addEventListener('click', () => {
          // Commit any ongoing text editing
          if (isEditing) {
            commitTextEditing();
          }
          
          currentMode = 'select';
          canvas.isDrawingMode = false;
          canvas.selection = true;  // Enable selection in select mode
          
          // Make all objects selectable in select mode
          canvas.forEachObject(function(obj) {
            obj.selectable = true;
          });
          
          setActiveButton(selectTool);
          showToolControls('select');
          console.log('Select tool selected');
        });
      }
      
      // Track path creation for undo
      canvas.on('path:created', function(e) {
        // Add the path to our history
        objectHistory.push(e.path);
        
        // Enable the undo button
        if (undoBtn) {
          undoBtn.disabled = false;
        }
      });
      
      // Clear button
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          if (confirm('Are you sure you want to clear all sketches?')) {
            // Commit any ongoing text editing
            if (isEditing) {
              commitTextEditing();
            }
            
            // Clear object history
            objectHistory.length = 0;
            
            // Remove all objects but keep background
            const backgroundImage = canvas.backgroundImage;
            canvas.clear();
            
            // Restore background
            if (backgroundImage) {
              canvas.setBackgroundImage(backgroundImage, canvas.renderAll.bind(canvas));
            } else {
              canvas.backgroundColor = 'white';
              canvas.renderAll();
            }
            
            // Disable undo button
            if (undoBtn) {
              undoBtn.disabled = true;
            }
            
            console.log('Canvas cleared');
            
            // Reset to pen tool after clearing
            if (penTool) {
              penTool.click();
            }
          }
        });
      }
      
      // Save button
      if (saveBtn) {
        saveBtn.addEventListener('click', () => {
          try {
            // Commit any ongoing text editing
            if (isEditing) {
              commitTextEditing();
            }
            
            console.log('Saving sketch...');
            
            // Show status message
            const statusMessage = document.getElementById('status-message');
            if (statusMessage) {
              statusMessage.textContent = 'Saving sketch...';
              statusMessage.style.display = 'block';
              statusMessage.style.backgroundColor = '#f8f9fa';
            }
            
            // Convert canvas to JSON
            const canvasData = JSON.stringify(canvas.toJSON());
            
            // Send data to the server
            fetch('<%= save_sketch_floorplan_path(@floorplan) %>', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
              },
              body: JSON.stringify({ 
                sketch_data: canvasData, 
                sketch_image: canvas.toDataURL('image/png') 
              })
            })
            .then(response => {
              if (!response.ok) {
                throw new Error('Network response was not ok');
              }
              return response.json();
            })
            .then(data => {
              console.log('Sketch saved successfully:', data);
              
              if (statusMessage) {
                statusMessage.textContent = 'Sketch saved successfully! Redirecting...';
                statusMessage.style.backgroundColor = '#d4edda';
              }
              
              // Redirect to the floorplan page after a short delay
              setTimeout(() => {
                window.location.href = data.redirect_url || '<%= floorplan_path(@floorplan) %>';
              }, 1500);
            })
            .catch(error => {
              console.error('Error saving sketch:', error);
              
              if (statusMessage) {
                statusMessage.textContent = 'Error saving sketch: ' + error.message;
                statusMessage.style.backgroundColor = '#f8d7da';
              }
            });
            
          } catch (error) {
            console.error('Error saving sketch:', error);
          }
        });
      }
      
      // Start with pen tool active
      if (penTool) {
        penTool.click();
      }
      
      // Function to deselect all objects
      function deselectAll() {
        canvas.discardActiveObject();
        canvas.renderAll();
      }
      
      // Add keyboard shortcut for delete key
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Delete' && !isEditing) {
          const activeObject = canvas.getActiveObject();
          if (activeObject) {
            // Remove from history when deleted
            const index = objectHistory.indexOf(activeObject);
            if (index !== -1) {
              objectHistory.splice(index, 1);
            }
            
            canvas.remove(activeObject);
            console.log('Object deleted');
          }
        }
      });
    }
  </script>
<% else %>
  <div class="alert alert-warning">
    This floorplan doesn't have an image attached. Please upload an image first.
  </div>
  
  <%= link_to 'Back to Floorplan', floorplan_path(@floorplan), class: 'btn btn-primary' %>
<% end %> 