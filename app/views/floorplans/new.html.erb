<h1>Upload Floorplan</h1>

<% if logged_in? %>
  <% if current_user.has_unlimited_generations? %>
    <div class="usage-status premium">
      <div class="usage-header">
        <span class="status-icon">✓</span>
        <span class="status-text">Premium Member - Unlimited Generations</span>
      </div>
      <p>You have unlimited access to all floorplan generation features!</p>
    </div>
  <% else %>
    <div class="usage-status free-tier">
      <div class="usage-header">
        <span class="status-icon">📊</span>
        <span class="status-text">Usage This Month</span>
      </div>
      
      <div class="usage-details">
        <div class="usage-bar-container">
          <div class="usage-bar">
            <div class="usage-fill" style="width: <%= current_user.usage_percentage %>%"></div>
          </div>
          <span class="usage-text">
            <%= current_user.image_generations_used %> / <%= User::FREE_TIER_MONTHLY_LIMIT %> generations used
          </span>
        </div>
        
        <% if current_user.image_generations_remaining > 0 %>
          <p class="usage-remaining">
            <%= form_with url: subscribe_path, method: :post, local: true, style: "display: inline;" do |f| %>
              <%= f.submit "Upgrade to Premium For Unlimited Access", 
                  class: "upgrade-link premium-cta",
                  data: { 
                    confirm: "Ready to upgrade to premium for $9/month?",
                    disable_with: "Processing..." 
                  } %>
            <% end %>
          </p>
          <% if current_user.image_generations_remaining == 1 %>
            <p class="upgrade-reminder">
              This is your last free generation! 
              <%= form_with url: subscribe_path, method: :post, local: true, style: "display: inline;" do |f| %>
                <%= f.submit "Upgrade to Premium", 
                    class: "upgrade-link",
                    data: { 
                      confirm: "Ready to upgrade to premium for $9/month?",
                      disable_with: "Processing..." 
                    } %>
              <% end %> for unlimited access.
            </p>
          <% end %>
        <% else %>
          <div class="limit-reached">
            <p><strong>Monthly limit reached!</strong></p>
            <p>Upgrade to premium for unlimited floorplan generations.</p>
            <%= form_with url: subscribe_path, method: :post, local: true, style: "display: inline;" do |f| %>
              <%= f.submit "Upgrade Now ($9/month)", 
                  class: "btn btn-premium",
                  data: { 
                    confirm: "Ready to upgrade to premium for $9/month?",
                    disable_with: "Processing..." 
                  } %>
            <% end %>
          </div>
        <% end %>
        
        <% if current_user.next_reset_date %>
          <p class="reset-info">
            Resets on <%= current_user.next_reset_date.strftime('%B 1, %Y') %>
          </p>
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="usage-status guest">
    <div class="usage-header">
      <span class="status-icon">📊</span>
      <span class="status-text">Get 3 Free Generations This Month</span>
    </div>
    <div class="guest-usage-info">
      <div class="usage-preview">
        <div class="usage-bar">
          <div class="usage-fill" style="width: 0%"></div>
        </div>
        <span class="usage-text">0 / 3 generations used</span>
      </div>
      <p>
        <%= form_with url: subscribe_path, method: :post, local: true, style: "display: inline;" do |f| %>
          <%= f.submit "Upgrade to premium", 
              class: "upgrade-link",
              data: { 
                confirm: "Ready to upgrade to premium for $9/month?",
                disable_with: "Processing..." 
              } %>
        <% end %> for unlimited access!
      </p>
    </div>
  </div>
<% end %>

<%= form_with(model: @floorplan, local: true, multipart: true) do |form| %>
  <% if @floorplan.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(@floorplan.errors.count, "error") %> prohibited this floorplan from being saved:</h2>
      <ul>
        <% @floorplan.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :original_image, "Floorplan Image" %>
    <%= form.file_field :original_image, accept: 'image/*' %>
  </div>

  <div class="generation-options">
    <h3>How would you like to generate your floorplan?</h3>
    <p class="options-help">Choose the option that best fits your needs:</p>
    
    <div class="option-group">
      <%= form.radio_button :generation_type, "immediate", id: "immediate_generation", checked: true %>
      <%= form.label :generation_type_immediate, "Generate Immediately", class: "option-label" %>
      <p class="option-description">Use our standard AI prompt to create a professional office layout right away.</p>
    </div>
    
    <div class="option-group">
      <%= form.radio_button :generation_type, "custom_prompt", id: "custom_generation" %>
      <%= form.label :generation_type_custom_prompt, "Add Custom Instructions", class: "option-label" %>
      <p class="option-description">Provide specific requirements and preferences before generating your floorplan.</p>
    </div>
    
    <div class="option-group">
      <%= form.radio_button :generation_type, "sketch", id: "sketch_generation" %>
      <%= form.label :generation_type_sketch, "Sketch & Customize", class: "option-label" %>
      <p class="option-description">Draw on your floorplan and add custom instructions for maximum control.</p>
    </div>
  </div>

  <div class="actions">
    <% if logged_in? && !current_user.can_generate_image? %>
      <div class="form-disabled">
        <p><strong>Upload disabled - Monthly limit reached</strong></p>
        <p>You've used all 3 free generations this month.</p>
        <%= form_with url: subscribe_path, method: :post, local: true, style: "display: inline;" do |f| %>
          <%= f.submit "Upgrade to Premium ($9/month)", 
              class: "btn btn-premium",
              data: { 
                confirm: "Ready to upgrade to premium for $9/month?",
                disable_with: "Processing..." 
              } %>
        <% end %>
      </div>
    <% else %>
      <%= form.submit "Upload Floorplan", class: "upload-btn" %>
    <% end %>
  </div>
<% end %>

<style>
