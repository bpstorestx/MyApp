<style>
  .floorplan-details {
    margin-bottom: 30px;
  }
  
  .floorplan-image {
    max-width: 100%;
    height: auto;
    border: 1px solid #ddd;
    border-radius: 4px;
    margin-bottom: 20px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }
  
  .image-section {
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid #eee;
  }
  
  .text-muted {
    color: #6c757d;
    margin-bottom: 10px;
  }
  
  .processing-status {
    padding: 15px;
    background-color: #f8f9fa;
    border-radius: 4px;
    margin-bottom: 20px;
  }
  
  .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #f3f3f3;
    border-top: 4px solid #3498db;
    border-radius: 50%;
    animation: spin 2s linear infinite;
    margin: 10px auto;
  }
  
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<h1>Floorplan Details</h1>

<div class="floorplan-details">
  <div class="image-section">
    <h2>Original Floorplan</h2>
    <% if @floorplan.original_image.attached? %>
      <%= image_tag @floorplan.original_image, class: "floorplan-image" %>
    <% end %>
  </div>
  
  <% if @floorplan.sketched_image.attached? %>
    <div class="image-section">
      <h2>Sketched Version</h2>
      <p class="text-muted">Your annotated version with drawings and notes</p>
      <%= image_tag @floorplan.sketched_image, class: "floorplan-image" %>
    </div>
  <% end %>

  <div class="image-section">
    <h2>Generated Layout</h2>
    <% if @floorplan.status == 'completed' && @floorplan.generated_image.attached? %>
      <p class="text-muted">AI-generated professional floorplan</p>
      <%= image_tag @floorplan.generated_image, class: "floorplan-image" %>
    <% elsif @floorplan.status == 'sketch_submitted' || @floorplan.status == 'pending' || @floorplan.status == 'processing' %>
      <div class="processing-status">
        <p>Your floorplan is currently being processed...</p>
        <div class="progress-indicator">
          <div class="spinner"></div>
        </div>
      </div>
    <% elsif @floorplan.status == 'failed' %>
      <p class="error-message">Processing failed. Please try again later.</p>
    <% else %>
      <p>Layout generation pending...</p>
    <% end %>
  </div>

  <div class="status">
    <strong>Status:</strong> <%= @floorplan.status %>
  </div>
</div>

<div class="action-links">
  <% if @floorplan.original_image.attached? %>
    <% button_text = (@floorplan.status == 'completed' && @floorplan.generated_image.attached?) ? "Re-Sketch on Original Floorplan" : "Sketch on this Floorplan" %>
    <%= link_to button_text, sketch_floorplan_path(@floorplan), class: "btn btn-primary" %> |
  <% end %>
  <% if @floorplan.status == 'completed' && @floorplan.generated_image.attached? %>
    <%= link_to "Sketch on the generated floorplan", sketch_floorplan_path(@floorplan, use_generated: true), class: "btn btn-success" %> |
  <% end %>
  <% if logged_in? %>
    <%= link_to "Back to My Floorplans", floorplans_path %> | 
  <% end %>
  <%= link_to "Upload Another Floorplan", new_floorplan_path %>
</div>

<% if @floorplan.status == 'pending' || @floorplan.status == 'processing' %>
  <script>
    // Auto-refresh the page every 5 seconds while processing
    setTimeout(function() {
      window.location.reload();
    }, 5000);
  </script>
<% end %> 