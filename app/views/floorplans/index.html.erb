<% content_for :title, "My Floorplans - FloorPlan Pro" %>

<div class="page-header">
  <h1>My Floorplans</h1>
  <p class="text-muted">Manage and view all your AI-generated floorplan designs.</p>
</div>

<% if @floorplans.empty? %>
  <div class="empty-state">
    <div class="empty-state-icon">📐</div>
    <h3>No floorplans yet</h3>
    <p>You haven't created any floorplans yet. Upload your first floorplan to get started with AI-powered design generation.</p>
    <%= link_to "Create Your First Floorplan", new_floorplan_path, class: "btn btn-primary btn-lg" %>
  </div>
<% else %>
  <div class="floorplans-grid">
    <% @floorplans.each do |floorplan| %>
      <div class="floorplan-card">
        <div class="floorplan-image">
          <% if floorplan.generated_image_url.present? %>
            <%= image_tag floorplan.generated_image_url, alt: "Generated Layout" %>
          <% elsif floorplan.original_image.attached? %>
            <%= image_tag floorplan.original_image.variant(resize_to_limit: [200, 200]), alt: "Original Floorplan" %>
          <% else %>
            <div class="placeholder-image">No image available</div>
          <% end %>
        </div>
        <div class="floorplan-details">
          <div class="floorplan-status <%= floorplan.status %>">
            <%= floorplan.status.humanize %>
          </div>
          <p class="floorplan-date">
            Created: <%= floorplan.created_at.strftime("%B %d, %Y") %>
          </p>
          <%= link_to "View Details", floorplan_path(floorplan), class: "view-button" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<div class="action-buttons">
  <%= link_to "Create New Floorplan", new_floorplan_path, class: "btn btn-secondary btn-lg" %>
</div> 